# Nukopijuok į .env ir pritaikyk lokaliam paleidimui. Produkcijoje (Deno Deploy)
# šie kintamieji nustatomi per dashboard'o Settings → Environment Variables.

# Serverio portas.
PORT=8000

# Druska įrenginio hash'ui (sha256(DEVICE_SALT + uuid)). Produkcijoje BŪTINA
# pakeisti į ilgą atsitiktinį stringą — nuo jo priklauso, ar hash'ą įmanoma
# atkurti brute-force būdu. Generuoti pvz.: openssl rand -hex 32
DEVICE_SALT=dev-only-salt-change-in-production

# Posto (srauto) gyvavimo laikas milisekundėmis. Naudinga sutrumpinti
# testuojant TTL elgseną lokaliai (pvz. 60000 = 1 min).
POST_TTL_MS=86400000

# Deno KV failo kelias lokaliam paleidimui. Praleidus — naudojamas Deno default
# (globalus dev KV failas po ~/.cache/deno). Deno Deploy'uje šis kintamasis
# nenaudojamas — KV ten automatinis.
# KV_PATH=./local.kv
